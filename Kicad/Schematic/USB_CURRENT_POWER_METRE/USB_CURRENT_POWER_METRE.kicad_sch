	)
	(text "WE have 2 5.1k Ohm pull down resistors required to tell a smart charger \n(lika a laptop or phone) if it can send power. \nThe way it works is the chrager will detect an open circuit \non CC1 and CC2 if there is no pull down resistors.\nThis is done for safety so that the smart charger \nwill not send any power, leading to a mulitmeter reading of 0V on VBUS.\n"
		(exclude_from_sim no)
		(at 178.816 83.058 0)
		(effects
			(font
				(size 1.778 1.778)
				(thickness 0.254)
				(bold yes)
			)
			(justify left)
		)
		(uuid "1e6a6370-adcb-4a62-9a77-ed9cb6be1718")
	)
